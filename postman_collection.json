  "item": [
    {
      "name": "🔐 Authentication (Supabase Auth)",
      "description": "Endpoint autentikasi menggunakan Supabase Auth API langsung.",
      "item": [
        {
          "name": "a. Login Admin (Memperoleh JWT Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('admin_token', jsonData.access_token);",
                  "    console.log('✅ Token berhasil disimpan ke variable admin_token');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{supabase_anon_key}}",
                "description": "Supabase Anon Key (wajib untuk akses Supabase Auth API)"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@helpdesk.com\",\n  \"password\": \"admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{supabase_url}}/auth/v1/token?grant_type=password",
              "host": ["{{supabase_url}}"],
              "path": ["auth", "v1", "token"],
              "query": [
                {
                  "key": "grant_type",
                  "value": "password"
                }
              ]
            },
            "description": "Login ke Supabase Auth untuk mendapatkan JWT access_token.\n\nGanti email & password sesuai akun admin yang sudah terdaftar di Supabase.\n\nResponse berisi:\n- access_token (JWT untuk header Authorization)\n- refresh_token\n- user object"
          },
          "response": [
            {
              "name": "200 OK — Login Berhasil",
              "originalRequest": {
                "method": "POST",
                "url": {
                  "raw": "{{supabase_url}}/auth/v1/token?grant_type=password"
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"access_token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx\",\n  \"token_type\": \"bearer\",\n  \"expires_in\": 3600,\n  \"expires_at\": 1751760000,\n  \"refresh_token\": \"xxxxx-refresh-token-xxxxx\",\n  \"user\": {\n    \"id\": \"a1b2c3d4-e5f6-7890-abcd-ef1234567890\",\n    \"email\": \"admin@helpdesk.com\",\n    \"role\": \"authenticated\",\n    \"created_at\": \"2026-01-15T10:00:00.000Z\"\n  }\n}"
            }
          ]
        },
        {
          "name": "Login User Biasa",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('user_token', jsonData.access_token);",
                  "    console.log('✅ User token disimpan');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{supabase_anon_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@helpdesk.com\",\n  \"password\": \"user123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{supabase_url}}/auth/v1/token?grant_type=password",
              "host": ["{{supabase_url}}"],
              "path": ["auth", "v1", "token"],
              "query": [
                {
                  "key": "grant_type",
                  "value": "password"
                }
              ]
            }
          }
        }
      ]
